<?xml version="1.0" encoding="utf-8"?>
<!--
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is used for devices older than API 31.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude the per-install ID so it is never restored onto a different device/install. -->
    <exclude domain="sharedpref" path="kolco24.install.xml"/>
    <!-- Exclude the admin token file so the bearer token is never included in backups. -->
    <exclude domain="sharedpref" path="kolco24.admin.xml"/>
    <!-- Exclude the trusted-time anchor so a restored anchor can't pass a warm start on a BOOT_COUNT collision. -->
    <exclude domain="sharedpref" path="kolco24.clock.xml"/>
    <!-- Exclude the MapLibre tile/resource cache (regenerable; online OSM tiles can grow it large). -->
    <exclude domain="file" path="mbgl-offline.db"/>
</full-backup-content>
